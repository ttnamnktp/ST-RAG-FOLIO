    "error_type": "nested_predicate",
    "description": "A predicate is incorrectly nested inside another predicate.",
    "parser_error_signature": {
      "expected": ["ID"],
      "got": ["NOT", "RPAREN"],
      "keywords": ["Expected ID", "got NOT", "got RPAREN"],
      "column_patterns": ["> 20"]
    },
    "detection_patterns": [
      "Predicate(¬Predicate(",
      "Predicate(Predicate("
    ],
    "fix_rules": [
      "Pull inner predicate out as a separate conjunct",
      "Move negation outside predicate",
      "Rewrite using implication"
    ],
    "rewrite_examples": [
      {
        "before": "Death(¬Treat(stonefish))",
        "after": "¬Treat(stonefish) ∧ Death(stonefish)"
      }
    ]
  },
